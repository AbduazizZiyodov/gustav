stdout true == true;    // expect: true
stdout true == false;   // expect: false
stdout false == true;   // expect: false
stdout false == false;  // expect: true

// Not equal to other types.
stdout true == 1;        // expect: false
stdout false == 0;       // expect: false
stdout true == "true";   // expect: false
stdout false == "false"; // expect: false
stdout false == "";      // expect: false

stdout true != true;    // expect: false
stdout true != false;   // expect: true
stdout false != true;   // expect: true
stdout false != false;  // expect: false

// Not equal to other types.
stdout true != 1;        // expect: true
stdout false != 0;       // expect: true
stdout true != "true";   // expect: true
stdout false != "false"; // expect: true
stdout false != "";      // expect: true
