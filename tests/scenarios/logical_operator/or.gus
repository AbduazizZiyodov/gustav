// Note: These tests implicitly depend on ints being truthy.

// Return the first true argument.
stdout 1 or true; // expect: 1
stdout false or 1; // expect: 1
stdout false or false or true; // expect: true

// Return the last argument if all are false.
stdout false or false; // expect: false
stdout false or false or false; // expect: false

// Short-circuit at the first true argument.
var a = "before";
var b = "before";
(a = false) or
    (b = true) or
    (a = "bad");
stdout a; // expect: false
stdout b; // expect: true
