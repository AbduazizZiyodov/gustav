// Note: These tests implicitly depend on ints being truthy.

// Return the first non-true argument.
stdout false and 1; // expect: false
stdout true and 1; // expect: 1
stdout 1 and 2 and false; // expect: false

// Return the last argument if all are true.
stdout 1 and true; // expect: true
stdout 1 and 2 and 3; // expect: 3

// Short-circuit at the first false argument.
var a = "before";
var b = "before";
(a = true) and
    (b = false) and
    (a = "bad");
stdout a; // expect: true
stdout b; // expect: false
