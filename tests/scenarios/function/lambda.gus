var f = λ(x) { return x + 1; };
stdout f(2); // expect: 3


stdout λ(x) { return x * x; }(4); // expect: 16

var a = 10;
var add_a = λ(x) { return x + a; };
stdout add_a(5); // expect: 15

var x = 1;
var f = λ(x) { return x + 100; };
stdout f(5); // expect: 105
stdout x; // expect: 1


var make_adder = λ(x) {
  return λ(y) { return x + y; };
};

var add_two = make_adder(2);
stdout add_two(3); // expect: 5
stdout make_adder(10)(1); // expect: 11


fun outer() {
  var z = 5;
  return λ(x) { return x + z; };
}
var closure = outer();
stdout closure(3); // expect: 8


var double = λ(x) {
  return x + x;
};
stdout double(7); // expect: 14


var give = λ() { return 42; };
stdout give(); // expect: 42


var test = λ(x) {
  if (x > 0) return "positive";
  return "non-positive";
};

stdout test(1); // expect: positive
stdout test(0); // expect: non-positive


fun Test() {
  var f = λ() {
    return "from lambda";
  };

  stdout f(); // expect: from lambda
  return "from function";
}

stdout Test(); // expect: from function

stdout λ() {}(); // expect: nil
stdout λ() {}; // expect: <λ fn>