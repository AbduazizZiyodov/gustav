fun f(x) {
    return x^2;
}

fun g(y) {
    return y - 1;
}

print f(2) |> g();

// expect: 3

fun square(n) { return n * n; }
fun dec(n) { return n - 1; }
fun toStr(x) { print "<converting>"; return x; }

print 3 |> square();                // expect: 9
print 5 |> square() |> dec();       // expect: 24
print 4 |> dec() |> square();       // expect: 9
print 2 |> square() |> toStr();     // expect: <converting>
                                    // expect: 4
print (true ? 2 : 3) |> square();    // expect: 4
print (false ? 2 : 3) |> square();   // expect: 9
print 3 |> (true ? square : dec)(); // expect: 9
print 3 |> (false ? square : dec)(); // expect: 2

fun id(x) { return x; }

print 42 |> id();                   // expect: 42
print "hi" |> id();                 // expect: hi
print nil |> id();                  // expect: nil