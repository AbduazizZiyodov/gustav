fun f(x) {
    return x^2;
}

fun g(y) {
    return y - 1;
}

stdout f(2) |> g();

// expect: 3

fun square(n) { return n * n; }
fun dec(n) { return n - 1; }
fun toStr(x) { stdout "<converting>"; return x; }

stdout 3 |> square();                // expect: 9
stdout 5 |> square() |> dec();       // expect: 24
stdout 4 |> dec() |> square();       // expect: 9
stdout 2 |> square() |> toStr();     // expect: <converting>
                                    // expect: 4
stdout (true ? 2 : 3) |> square();    // expect: 4
stdout (false ? 2 : 3) |> square();   // expect: 9
stdout 3 |> (true ? square : dec)(); // expect: 9
stdout 3 |> (false ? square : dec)(); // expect: 2

fun id(x) { return x; }

stdout 42 |> id();                   // expect: 42
stdout "hi" |> id();                 // expect: hi
stdout nil |> id();                  // expect: nil