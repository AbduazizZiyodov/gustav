class Foo {
  foo(a, b) {
    this.field1 = a;
    this.field2 = b;
  }

  foostdout() {
    stdout this.field1;
    stdout this.field2;
  }
}

class Bar < Foo {
  bar(a, b) {
    this.field1 = a;
    this.field2 = b;
  }

  barstdout() {
    stdout this.field1;
    stdout this.field2;
  }
}

var bar = Bar();
bar.foo("foo 1", "foo 2");
bar.foostdout();
// expect: foo 1
// expect: foo 2

bar.bar("bar 1", "bar 2");
bar.barstdout();
// expect: bar 1
// expect: bar 2

bar.foostdout();
// expect: bar 1
// expect: bar 2
