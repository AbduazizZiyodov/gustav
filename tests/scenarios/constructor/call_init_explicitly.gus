class Foo {
  init(arg) {
    stdout "Foo.init(" ++ arg ++ ")";
    this.field = "init";
  }
}

var foo = Foo("one"); // expect: Foo.init(one)
foo.field = "field";

var foo2 = foo.init("two"); // expect: Foo.init(two)
stdout foo2; // expect: Foo<Instance>

// Make sure init() doesn't create a fresh instance.
stdout foo.field; // expect: init
