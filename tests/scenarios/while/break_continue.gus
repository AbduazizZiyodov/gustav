var i = 0;
while (i < 5) {
  i = i + 1;
  if (i == 3) continue;
  print i;
}
// expect: 1
// expect: 2
// expect: 4
// expect: 5

// Basic break.
var j = 0;
while (j < 5) {
  print j;
  if (j == 2) break;
  j = j + 1;
}
// expect: 0
// expect: 1
// expect: 2

var a = 0;
while (a < 2) {
  var b = 0;
  while (b < 3) {
    b = b + 1;
    if (b == 2) continue;
    print a * 10 + b;
  }
  a = a + 1;
}
// expect: 1
// expect: 3
// expect: 11
// expect: 13

var x = 0;
while (x < 2) {
  var y = 0;
  while (y < 3) {
    print x * 10 + y;
    if (y == 1) break;
    y = y + 1;
  }
  x = x + 1;
}
// expect: 0
// expect: 1
// expect: 10
// expect: 11

var m = 0;
while (m < 3) {
  var n = 0;
  while (n < 3) {
    if (m == 1 and n == 1) break;
    print m * 10 + n;
    n = n + 1;
  }
  if (m == 1) break;
  m = m + 1;
}
// expect: 0
// expect: 1
// expect: 2
// expect: 10

var c = 0;
while (c < 3)
  if ((c = c + 1) == 2) continue;
  else print c;
// expect: 1
// expect: 3

var z = 0;
while (z < 5)
  if ((z = z + 1) == 3) break;
  else print z;
// expect: 1
// expect: 2
