fun do_break(x) {
  if (x == 1) break; // expect: [at line 2] Error at ';': Can't use 'break' outside of a loop.
}
var i = 0;
while (i < 3) {
  do_break(i);
  stdout i;
  i = i + 1;
}


fun do_continue(x) {
  if (x == 1) continue; // expect: [at line 13] Error at ';': Can't use 'continue' outside of a loop.
}
var j = 0;
while (j < 3) {
  do_continue(j);
  stdout j;
  j = j + 1;
}

var k = 0;
while (k < 3) {
  lambda () { break; }; // expect: [at line 24] Error at ';': Can't use 'break' outside of a loop.
  stdout k;
  k = k + 1;
}


var l = 0;
while (l < 3) {
  lambda () { continue; }; // expect: [at line 32] Error at ';': Can't use 'continue' outside of a loop.
  stdout l;
  l = l + 1;
}


var m = 0;
while (m < 3) {
  fun inner() {
    if (true) break; // expect: [at line 41] Error at ';': Can't use 'break' outside of a loop.
  }
  inner();
  stdout m;
  m = m + 1;
}


var n = 0;
while (n < 3) {
  if (true) {
    lambda () {
      if (true) {
        continue; // expect: [at line 54] Error at ';': Can't use 'continue' outside of a loop.
      }
    }();
  }
  stdout n;
  n = n + 1;
}

lambda () {
  lambda () {
    continue; // expect: [at line 64] Error at ';': Can't use 'continue' outside of a loop.
  }();
}();
