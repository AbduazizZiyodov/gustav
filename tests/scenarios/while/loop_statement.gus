var i = 0;
loop {
  i = i + 1;
  if (i == 3) continue;
  if (i == 6) break;
  stdout i;
}
// expect: 1
// expect: 2
// expect: 4
// expect: 5


var j = 0;
loop {
  stdout j;
  if (j == 2) break;
  j = j + 1;
}
// expect: 0
// expect: 1
// expect: 2


var a = 0;
loop {
  if (a == 2) break;
  var b = 0;
  loop {
    b = b + 1;
    if (b == 2) continue;
    if (b == 3) break;
    stdout a * 10 + b;
  }
  a = a + 1;
}
// expect: 1
// expect: 11


var x = 0;
loop {
  if (x == 2) break;
  var y = 0;
  loop {
    stdout x * 10 + y;
    if (y == 1) break;
    y = y + 1;
  }
  x = x + 1;
}
// expect: 0
// expect: 1
// expect: 10
// expect: 11


var m = 0;
loop {
  if (m == 3) break;
  var n = 0;
  loop {
    if (m == 1 and n == 1) break;
    stdout m * 10 + n;
    n = n + 1;
    if (n == 3) break;
  }
  if (m == 1) break;
  m = m + 1;
}
// expect: 0
// expect: 1
// expect: 2
// expect: 10


var c = 0;
loop if ((c = c + 1) == 2) continue;
else if (c == 4) break;
else stdout c;
// expect: 1
// expect: 3


var z = 0;
loop if ((z = z + 1) == 3) break;
else stdout z;
// expect: 1
// expect: 2
