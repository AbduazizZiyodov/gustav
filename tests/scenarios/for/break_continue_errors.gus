fun do_break(x) {
  if (x == 1) break; // expect: Can't use 'break' outside of a loop.
}
for (var i = 0; i < 3; i = i + 1) {
  do_break(i);
  print i;
}


fun do_continue(x) {
  if (x == 1) continue; // expect: Can't use 'continue' outside of a loop.
}
for (var i = 0; i < 3; i = i + 1) {
  do_continue(i);
  print i;
}


for (var i = 0; i < 3; i = i + 1) {
  lambda () { break; }; // expect: Can't use 'break' outside of a loop.
  print i;
}


for (var i = 0; i < 3; i = i + 1) {
  lambda () { continue; }; // expect: Can't use 'continue' outside of a loop.
  print i;
}


for (var i = 0; i < 3; i = i + 1) {
  fun inner() {
    if (true) break; // expect: Can't use 'break' outside of a loop.
  }
  inner();
  print i;
}

for (var i = 0; i < 3; i = i + 1) {
  if (true) {
    lambda () {
      if (true) {
        continue; // expect: Can't use 'continue' outside of a loop.
      }
    }();
  }
  print i;
}