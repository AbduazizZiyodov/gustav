// * has higher precedence than +.
stdout 2 + 3 * 4; // expect: 14

// * has higher precedence than -.
stdout 20 - 3 * 4; // expect: 8

// / has higher precedence than +.
stdout 2 + 6 / 3; // expect: 4

// / has higher precedence than -.
stdout 2 - 6 / 3; // expect: 0

// < has higher precedence than ==.
stdout false == 2 < 1; // expect: true

// > has higher precedence than ==.
stdout false == 1 > 2; // expect: true

// <= has higher precedence than ==.
stdout false == 2 <= 1; // expect: true

// >= has higher precedence than ==.
stdout false == 1 >= 2; // expect: true

// 1 - 1 is not space-sensitive.
stdout 1 - 1; // expect: 0
stdout 1 -1;  // expect: 0
stdout 1- 1;  // expect: 0
stdout 1-1;   // expect: 0

// Using () for grouping.
stdout (2 * (6 - (2 + 2))); // expect: 4
