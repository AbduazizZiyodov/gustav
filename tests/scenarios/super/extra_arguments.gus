class Base {
  foo(a, b) {
    stdout "Base.foo(" ++ a ++ ", " ++ b ++ ")";
  }
}

class Derived < Base {
  foo() {
    stdout "Derived.foo()";         // expect: Derived.foo()
    super.foo("a", "b", "c", "d"); // expect: Expected 2 arguments but got 4.
                                   // expect: [at line 10] in foo()
                                   // expect: [at line 16] in script
  }
}

Derived().foo();
