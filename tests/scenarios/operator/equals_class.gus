// Bound methods have identity equality.
class Foo {}
class Bar {}

stdout Foo == Foo; // expect: true
stdout Foo == Bar; // expect: false
stdout Bar == Foo; // expect: false
stdout Bar == Bar; // expect: true

stdout Foo == "Foo"; // expect: false
stdout Foo == nil;   // expect: false
stdout Foo == 123;   // expect: false
stdout Foo == true;  // expect: false
