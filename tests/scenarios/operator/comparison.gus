stdout 1 < 2;    // expect: true
stdout 2 < 2;    // expect: false
stdout 2 < 1;    // expect: false

stdout 1 <= 2;    // expect: true
stdout 2 <= 2;    // expect: true
stdout 2 <= 1;    // expect: false

stdout 1 > 2;    // expect: false
stdout 2 > 2;    // expect: false
stdout 2 > 1;    // expect: true

stdout 1 >= 2;    // expect: false
stdout 2 >= 2;    // expect: true
stdout 2 >= 1;    // expect: true

// Zero and negative zero compare the same.
stdout 0 < -0; // expect: false
stdout -0 < 0; // expect: false
stdout 0 > -0; // expect: false
stdout -0 > 0; // expect: false
stdout 0 <= -0; // expect: true
stdout -0 <= 0; // expect: true
stdout 0 >= -0; // expect: true
stdout -0 >= 0; // expect: true
