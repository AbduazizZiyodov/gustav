stdout nil == nil; // expect: true

stdout true == true; // expect: true
stdout true == false; // expect: false

stdout 1 == 1; // expect: true
stdout 1 == 2; // expect: false

stdout "str" == "str"; // expect: true
stdout "str" == "ing"; // expect: false

stdout nil == false; // expect: false
stdout false == 0; // expect: false
stdout 0 == "0"; // expect: false
